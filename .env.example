# Copy to .env and fill in values. Never commit .env.
DATABASE_URL="postgresql://app:app@localhost:5433/taskdb?schema=public"
PORT=3000
NODE_ENV="development"

# Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET="change-me-access"
REFRESH_TOKEN_SECRET="change-me-refresh"

# Frontend origin for CORS (comma-separated for multiple)
FRONTEND_URL="http://localhost:5173"

# Google login (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Required for POST /auth/google and POST /auth/google/link.
GOOGLE_CLIENT_ID=""
# Optional comma-separated allowlist, e.g. "example.com,other.org". Unset = allow all domains.
# GOOGLE_ALLOWED_DOMAINS=""
